# Everything here is optional for trying it out: with no admin mechanism configured the server makes its own token and
# encryption key on first start (kept in DATA_DIR/local-secrets.json) and prints a signed-in console link.
# For a real deployment set an admin mechanism, VANTAGE_ENCRYPTION_KEY, PUBLIC_URL and CONTENT_ORIGIN.

# --- admin: at least one of the three ---
# Long random secret used by the console, CLI and MCP server.  npm run gen-token
ADMIN_TOKEN=
# Emails allowed in via the SSO header (needs TRUST_PROXY + TRUSTED_HEADER_EMAIL) or via Google sign-in.
# With Google sign-in and this empty, anyone with a Google account may sign in.
ADMIN_EMAILS=
# "Sign in with Google" for a hosted copy. Redirect URI: PUBLIC_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# With Google sign-in: only these email domains may sign in (comma separated). Empty = anyone, unless ADMIN_EMAILS is set.
ALLOWED_SIGNIN_DOMAINS=
# Shown to testers on the consent screen as the place to report a link they were not expecting
ABUSE_EMAIL=

# --- strongly recommended ---
# 32-byte hex key; encrypts prototype files and the metadata store on disk.  npm run gen-key
VANTAGE_ENCRYPTION_KEY=
# Address of the console and tester pages, e.g. https://prototypes.internal.company.com
PUBLIC_URL=
# Address prototypes are served from: a second hostname behind your proxy, or the second port's address.
# Default: http://localhost:<PORT+1>. With a wildcard (https://*.content.example.com) every share gets its own origin.
CONTENT_ORIGIN=
# Second listener for prototype content. Default PORT+1. Set 0 to route by hostname only.
CONTENT_PORT=

# --- behind a reverse proxy / identity-aware proxy ---
# Set to 1 only when a proxy you control sits in front of the server (also correct on Cloud Run).
TRUST_PROXY=0
# How many proxies append to X-Forwarded-For before the request reaches us (Cloud Run, nginx: 1)
TRUSTED_PROXY_HOPS=1
# Header the proxy sets with the authenticated user's email, lower-case.
# Examples: cf-access-authenticated-user-email (Cloudflare Access), x-goog-authenticated-user-email (Google IAP),
# x-ms-client-principal-name (Azure App Service EasyAuth), x-forwarded-email (oauth2-proxy)
TRUSTED_HEADER_EMAIL=
# Optional: where the console's "Sign out of company sign-in" button sends people
SSO_LOGOUT_URL=

# --- per-person limits (0 = unlimited; the server admin token is exempt) ---
MAX_SHARES_PER_OWNER=0
MAX_STORAGE_MB_PER_OWNER=0
# Or a module exporting limits(owner) -> { shares, storageMb }
ENTITLEMENTS_MODULE=

# --- policy ---
DEFAULT_EXPIRY_DAYS=7
MAX_EXPIRY_DAYS=365
# Days after expiry before prototype files are deleted; also how long admin-log lines are kept
RETENTION_DAYS=30
SESSION_HOURS=8
MAX_UPLOAD_MB=25
# Intro media plus voice recordings, per share; also counted toward each person's storage limit
MAX_MEDIA_MB=200
# Comma-separated origins prototypes may load assets from. Empty = none (recommended; inline assets instead).
ALLOWED_EXTERNAL_ORIGINS=

PORT=8787
# Quick start (no admin configured) listens on 127.0.0.1 only. Set this to let other devices connect.
HOST=0.0.0.0
DATA_DIR=./data
