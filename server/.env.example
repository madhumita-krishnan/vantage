# Everything here is optional for trying it out: with no ADMIN_TOKEN and no ADMIN_EMAILS the server makes its own
# token and encryption key on first start (kept in DATA_DIR/local-secrets.json) and prints a signed-in console link.
# For a real deployment set at least ADMIN_TOKEN or ADMIN_EMAILS, VAULT_ENCRYPTION_KEY, and PUBLIC_URL.

# --- admin: one of the two mechanisms ---
# Long random secret used by the admin UI, CLI and MCP server.  npm run gen-token
ADMIN_TOKEN=
# Or/and: emails that are admins when authenticated by your SSO proxy (needs TRUST_PROXY + TRUSTED_HEADER_EMAIL)
ADMIN_EMAILS=

# --- strongly recommended ---
# 32-byte hex key; encrypts prototype files and the metadata store on disk.  npm run gen-key
VAULT_ENCRYPTION_KEY=
# Public address viewers use, e.g. https://prototypes.internal.company.com
PUBLIC_URL=

# --- behind a reverse proxy / identity-aware proxy ---
# Set to 1 only when a proxy you control sits in front of the server.
TRUST_PROXY=0
# Header the proxy sets with the authenticated user's email, lower-case.
# Examples: cf-access-authenticated-user-email (Cloudflare Access), x-goog-authenticated-user-email (Google IAP),
# x-ms-client-principal-name (Azure App Service EasyAuth), x-forwarded-email (oauth2-proxy)
TRUSTED_HEADER_EMAIL=
# Optional: where the console's "Sign out of company sign-in" button sends people (your proxy's logout URL, e.g. /cdn-cgi/access/logout for Cloudflare Access, /oauth2/sign_out for oauth2-proxy)
SSO_LOGOUT_URL=

# --- policy ---
DEFAULT_EXPIRY_DAYS=7
MAX_EXPIRY_DAYS=90
# Days after expiry before prototype files are deleted automatically
RETENTION_DAYS=30
SESSION_HOURS=8
MAX_UPLOAD_MB=100
# Comma-separated origins prototypes may load assets from. Empty = none (recommended; inline assets instead).
ALLOWED_EXTERNAL_ORIGINS=

PORT=8787
# Quick start (no admin configured) listens on 127.0.0.1 only. Set this to let other devices connect.
HOST=0.0.0.0
DATA_DIR=./data
