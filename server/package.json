{
  "name": "vantage",
  "version": "0.3.1",
  "description": "Self-hosted, access-controlled sharing for coded prototypes. Zero dependencies.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "gen-token": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64url'))\"",
    "gen-key": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {}
}
